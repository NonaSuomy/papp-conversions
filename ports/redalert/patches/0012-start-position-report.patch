+// Sync debugging: append to the start-position report without overrunning it.
+static void Start_Report(char* buf, size_t size, const char* fmt, ...)
+{
+    size_t len = strlen(buf);
+    if (len + 1 >= size) {
+        return;
+    }
+    va_list args;
+    va_start(args, fmt);
+    vsnprintf(buf + len, size - len, fmt, args);
+    va_end(args);
+}
